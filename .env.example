# ---------------------------------------------------------------------------
# Salin jadi .env lalu isi. JANGAN commit .env.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Database yang sama dengan bot (repo voler-scam-guard); skema & migrasinya
# diurus di repo bot. Supabase -> Connect -> Session pooler:
#   postgresql://postgres.<project_ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# - Password yang berisi @ : / ? # % harus di-URL-encode.
# - Jangan tambahkan ?sslmode=... — SSL diatur lewat DATABASE_SSL_CA_FILE.
# Postgres lokal dari repo bot (npm run dev): postgres://vsg:<password>@localhost:5433/voler_scam_guard
DATABASE_URL=
# CA cert Supabase (Project Settings -> Database -> SSL Configuration ->
# Download certificate). Path relatif ke root project. Wajib untuk host
# Supabase; kosongkan untuk Postgres lokal.
DATABASE_SSL_CA_FILE=certs/supabase-ca.crt
# Batas koneksi pool dashboard. Total dengan BOT_DB_POOL_MAX (repo bot) harus
# di bawah "Pool Size" pooler Supabase.
DASHBOARD_DB_POOL_MAX=3

# --- Discord OAuth ---------------------------------------------------------
# Aplikasi Discord yang sama dengan bot.
# Developer Portal -> General Information -> Application ID
DISCORD_CLIENT_ID=
# Developer Portal -> OAuth2 -> Client Secret
DISCORD_CLIENT_SECRET=

# --- Dashboard -------------------------------------------------------------
# Container dipublikasikan di port 9001 (docker-compose.yml), tanpa TLS.
# Harus URL lengkap dan sama persis dengan yang dibuka di browser — nilai ini
# juga menentukan flag Secure pada cookie sesi (https -> Secure, http -> tidak).
# Ganti localhost dengan IP/domain server kalau diakses dari mesin lain.
# Daftarkan DUA redirect URI di Discord OAuth2, sama persis:
#   http://localhost:9001/api/auth/callback     (login)
#   http://localhost:9001/api/install/callback  (pasang bot)
DASHBOARD_URL=http://localhost:9001
# Kunci penandatangan cookie sesi dan enkripsi token Discord. WAJIB minimal 32
# karakter — dashboard menolak jalan kalau lebih pendek. Buat dengan:
#   openssl rand -base64 48
AUTH_SECRET=
# Discord user ID pemilik bot, pisahkan dengan koma. HANYA ID ini yang bisa
# login ke dashboard; menghapus ID di sini langsung mencabut aksesnya.
# Samakan dengan BOT_OWNER_IDS di .env bot.
BOT_OWNER_IDS=
